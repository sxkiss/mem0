#!/bin/bash
API="http://localhost:8000"
AGENT="${2:-cli}"
CMD="$1"

case "$CMD" in
    add)
        TEXT="$2"
        AGENT="${3:-cli}"
        curl -s -X POST "$API/memories" -H "Content-Type: application/json" \
            -d "{\"messages\":[{\"role\":\"user\",\"content\":\"$TEXT\"}],\"agent_id\":\"$AGENT\"}" | python3 -m json.tool
        ;;
    search)
        QUERY="$2"
        AGENT="${3:-cli}"
        curl -s -X POST "$API/search" -H "Content-Type: application/json" \
            -d "{\"query\":\"$QUERY\",\"agent_id\":\"$AGENT\"}" | python3 -m json.tool
        ;;
    list)
        AGENT="${2:-cli}"
        curl -s "$API/memories?agent_id=$AGENT" | python3 -m json.tool
        ;;
    all)
        QUERY="$2"
        curl -s -X POST "$API/search" -H "Content-Type: application/json" \
            -d "{\"query\":\"$QUERY\",\"top_k\":10}" | python3 -m json.tool
        ;;
    *)
        echo "用法: mem0-cli {add|search|list|all} [参数] [agent_id]"
        ;;
esac
